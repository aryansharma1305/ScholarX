# Core Providers
EMBEDDING_PROVIDER=sentence-transformers
# Options: "grok" | "openai" | "ollama" | "simple" (no LLM, template-based)
LLM_PROVIDER=grok

# Grok / xAI (required when LLM_PROVIDER=grok)
# Sign up at https://console.x.ai for a free API key
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# Optional OpenAI (required only when provider is set to openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_LLM_MODEL=gpt-4o-mini

# Optional Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Vector Store
CHROMA_COLLECTION_NAME=rag-papers
CHROMA_PERSIST_DIR=./chroma_db

# Retrieval and Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_TOP_K=5
MAX_PAPERS_PER_QUERY=5
USE_SMART_CHUNKING=true

# LangGraph orchestration and local conversation checkpoints
USE_LANGGRAPH=true
LANGGRAPH_CHECKPOINT_PATH=./.runtime/langgraph_checkpoints.sqlite3
LANGGRAPH_MAX_EXTERNAL_SEARCHES=1
LANGGRAPH_MAX_ANSWER_RETRIES=1
LANGGRAPH_MIN_CONTEXT_CHUNKS=3
LANGGRAPH_MIN_RELEVANCE_SCORE=0.45
LANGGRAPH_INGEST_LIMIT=3
LANGGRAPH_USE_LLM_GRADER=true

# Citation-graph-aware retrieval boost (0=off, 0.15=default, 0.3=aggressive)
CITATION_BOOST_WEIGHT=0.15
# Minimum anchor overlap to apply boost (1=any, 2=multi-confirm, ablation axis #3)
MIN_CITATION_ANCHOR_HITS=1
# 2-hop neighbourhood expansion at 0.5× weight (false=off, true=extra API calls)
USE_2HOP_CITATION=false

# External Scholarly APIs
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
CROSSREF_USER_AGENT=ScholarX/1.0
CORE_API_KEY=
CORE_BASE_URL=https://api.core.ac.uk/v3
